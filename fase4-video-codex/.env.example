# As URLs são do roteiro do usuário e usam serviços locais. Confira se a aplicação está rodando.
OS_SWAGGER=http://localhost:8081/swagger-ui/index.html
BILLING_SWAGGER=http://localhost:8082/swagger-ui/index.html
EXECUTION_SWAGGER=http://localhost:8083/swagger-ui/index.html
SAGA_SWAGGER=http://localhost:8084/swagger-ui/index.html
RABBIT_URL=http://localhost:15672
GRAFANA_URL=http://localhost:3000/d/oficina-fase4
PROMETHEUS_URL=http://localhost:9090/targets

# Raiz do repositório original. Se este pacote estiver dentro dela, use ..
REPO_ROOT=..

# Segurança: TRUE somente após conferir a base de demonstração.
# Ativa POST/PATCH previstos no roteiro, inclusive falha controlada/compensação.
ALLOW_DEMO_MUTATIONS=false
VIDEO_MODE=ensaio

# Deixe vazios se sua sessão já tiver login. Nunca publique este arquivo.
RABBIT_USER=
RABBIT_PASSWORD=
GRAFANA_USER=
GRAFANA_PASSWORD=

# Windows = voz local SAPI em português; OpenAI opcional com custo separado.
VOICE_PROVIDER=windows
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=cedar

# Para modo final, o Codex deve auditar e configurar as evidências reais.
EVIDENCE_ACTIONS_URL=
EVIDENCE_JACOCO_DIR=
EVIDENCE_SONAR_URL=
EVIDENCE_K8S_PATH=

# Deixe false caso não deseje capturar o desktop inteiro.
CAPTURE_DESKTOP=true
