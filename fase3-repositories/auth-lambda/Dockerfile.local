# Imagem para executar a função fora da AWS (kind, docker-compose, CI).
# Na AWS usa-se o Dockerfile padrão (base public.ecr.aws/lambda/nodejs:22) ou o zip do Terraform.
FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
USER node
EXPOSE 8081
CMD ["node", "src/server.js"]
