        "uid": "oficina-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_sum{job=\"oficina-fase4\",uri!~\"/actuator.*|/swagger.*|/api-docs.*\"}[1m])) / clamp_min(sum by (application) (rate(http_server_requests_seconds_count{job=\"oficina-fase4\",uri!~\"/actuator.*|/swagger.*|/api-docs.*\"}[1m])), 0.000001)",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
