{
  "uid": "oficina-fase4",
  "title": "Oficina Mecânica | Fase 4",
  "description": "Métricas reais coletadas a cada 5s dos quatro serviços. Contadores de negócio reiniciam com a aplicação. Este dashboard não coleta traces distribuídos.",
  "tags": [
    "oficina",
    "fase4"
  ],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Serviços disponíveis / 4",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "oficina-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"oficina-fase4\"})",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
